# .gitignore raíz — aplica a TODO el repositorio.
# El proyecto vive en frontend/ (que además tiene su propio .gitignore).
# Regla general: aquí va lo que NO debe subirse pero sí existir en tu máquina.

# ── Dependencias (se reinstalan con `yarn install`) ──
node_modules/
.pnp
.pnp.js
.yarn-integrity

# ── Lockfile suelto en la raíz (el válido es frontend/yarn.lock) ──
/yarn.lock

# ── Builds / salida generada ──
build/
dist/
out/

# ── Tests / cobertura ──
coverage/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Variables de entorno (suelen contener secretos: NUNCA subir) ──
.env
.env.local
.env.*.local
!.env.example

# ── Cachés ──
.eslintcache
.cache/

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*~

# ── Sistema operativo / OneDrive ──
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
